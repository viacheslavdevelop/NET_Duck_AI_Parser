<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <AssemblyName>duckai</AssemblyName>
        <RootNamespace>DuckAi.Cli</RootNamespace>
        <PackageId>DuckAi.Cli</PackageId>
        <Version>0.1.0</Version>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>duckai</ToolCommandName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\DuckAi.Core\DuckAi.Core.csproj"/>
        <PackageReference Include="Microsoft.Playwright" Version="1.64.1"/>
    </ItemGroup>

</Project>
